# 本地 API 设置示例。复制为 API/.env 后填写自己的密钥，或在“API 设置”页面保存。
# 不配置任何供应商密钥也能启动本地画布；调用在线服务前再设置对应密钥。
# 密钥只保存在本机 API/.env，切勿提交到 Git 或分享截图。

COMFLY_API_KEY=
MODELSCOPE_API_KEY=
RUNNINGHUB_API_KEY=
RUNNINGHUB_WALLET_API_KEY=
ARK_API_KEY=
VOLCENGINE_ACCESS_KEY_ID=
VOLCENGINE_SECRET_ACCESS_KEY=

# 可选：有自己的 ComfyUI 服务时修改地址。
COMFYUI_INSTANCES=127.0.0.1:8188

# 可选：诊断日志文件路径。留空时由程序使用 data/logs/diagnostics.log，按大小自动轮转。
DIAGNOSTIC_LOG_FILE=
# 可选：单个日志文件大小和保留的旧文件数量；范围分别为 1 KiB～64 MiB、1～20。
DIAGNOSTIC_LOG_MAX_BYTES=2097152
DIAGNOSTIC_LOG_BACKUP_COUNT=3
